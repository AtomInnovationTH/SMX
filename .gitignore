.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Dependencies
node_modules/
bower_components/

# Optional browser smoke test (tests/smoke/): playwright-core is installed locally and
# never committed — the repo stays zero-dependency. node_modules/ is already ignored
# above; also ignore the local package manifests the install would create.
tests/smoke/package.json
tests/smoke/package-lock.json
/package.json
/package-lock.json

# Build output
dist/
build/
*.min.js
*.min.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Cache
.cache/
*.cache

# Kilo agent tooling (local only)
.kilo/

# Local art-generation working dir: the OUTPUTS stay local (raw renders, keyed
# sprites, rejects, contact sheets), but the pipeline CODE is tracked — it is
# original work, contains no credentials, and art-gen/manifest.py holds the
# hand-written de-branded subject descriptions.
art-gen/*
!art-gen/*.py

# Local working files — art pipeline preview + agent handoff notes (never on remote)
art-preview.html
handoff.md

# Source papers — REFERENCE ONLY, NEVER COMMITTED.
# The research this project illustrates belongs to its authors. Gassend's ISDC 2025
# slides, Wessels' arXiv paper and Lofstrom's write-up carry no redistribution grant,
# and ATTRIBUTIONS.md stakes its credibility on nothing third-party being shipped here.
# Keep them locally for reference; link to the authors' own copies instead (see
# ATTRIBUTIONS.md). This pattern exists because a `git add -A` once swept the ISDC PDF
# into a commit by accident.
*.pdf
